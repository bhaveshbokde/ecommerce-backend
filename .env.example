# =============================================================================
#  E-commerce Backend — environment template
# =============================================================================
#  This file is a TEMPLATE and is committed. It contains no real secrets.
#
#  The real file is `.env`, which is git-ignored. Generate it with:
#
#      ./scripts/provision-db.sh
#
#  which creates the database role and databases, invents a password and a JWT
#  signing key, and writes `.env` with mode 0600. You should not need to edit it
#  by hand, and you should never commit it.
#
#  Spring loads `.env` via `spring.config.import` in application.yml. That path
#  resolves against the WORKING DIRECTORY, not the jar — so if you run from an
#  IDE, set the run configuration's working directory to the project root or
#  none of these values resolve and startup fails on the JWT key length check.
# =============================================================================

# -----------------------------------------------------------------------------
#  Database
# -----------------------------------------------------------------------------
ECOMMERCE_DB_URL=jdbc:postgresql://127.0.0.1:5432/ecommerce_db
ECOMMERCE_DB_USERNAME=ecommerce_app

# The application's database password. Generated by provision-db.sh.
# The role is created NOSUPERUSER NOCREATEDB NOCREATEROLE and owns only its own
# two databases — it cannot reach anything else on the server.
ECOMMERCE_DB_PASSWORD=replace-me-run-scripts-provision-db-sh

# A separate database for the integration tests. They DELETE between test
# classes, so pointing this at the development database would destroy work in
# progress.
ECOMMERCE_TEST_DB_URL=jdbc:postgresql://127.0.0.1:5432/ecommerce_test_db

# -----------------------------------------------------------------------------
#  JWT signing
# -----------------------------------------------------------------------------
# At least 32 bytes (256 bits) of key material — the HS256 minimum from
# RFC 7518 §3.2. Accepts base64 or a long raw string; a short value fails at
# startup rather than at the first login in production.
#
# Generate one with:
#     head -c 64 /dev/urandom | base64 | tr -d '\n'
ECOMMERCE_JWT_SECRET=replace-me-with-at-least-32-bytes-of-random-key-material

ECOMMERCE_JWT_ISSUER=ecommerce-backend
ECOMMERCE_JWT_ACCESS_TTL=PT30M
ECOMMERCE_JWT_REFRESH_TTL=P7D

# -----------------------------------------------------------------------------
#  Redis
# -----------------------------------------------------------------------------
ECOMMERCE_REDIS_HOST=localhost
ECOMMERCE_REDIS_PORT=6379
ECOMMERCE_REDIS_PASSWORD=
ECOMMERCE_CACHE_ENABLED=true

# -----------------------------------------------------------------------------
#  Development administrator
# -----------------------------------------------------------------------------
# Created once at startup, ONLY when both values are set AND the active profile
# is not `prod`. The migrations seed no users at all, so there is no committed
# credential anywhere in this repository.
#
# Needed because the public registration endpoint hard-codes ROLE_CUSTOMER by
# design — without this there would be no way to reach an admin endpoint on a
# fresh database.
ECOMMERCE_ADMIN_EMAIL=
ECOMMERCE_ADMIN_PASSWORD=

# -----------------------------------------------------------------------------
#  Payments (simulated — no real money moves anywhere)
# -----------------------------------------------------------------------------
# SUCCESS | DECLINE | PROVIDER_ERROR. Deterministic by design: a random outcome
# would make the test suite flaky and a demonstration unreproducible.
ECOMMERCE_PAYMENT_OUTCOME=SUCCESS

# -----------------------------------------------------------------------------
#  Web
# -----------------------------------------------------------------------------
SERVER_PORT=8080
ECOMMERCE_CORS_ORIGINS=http://localhost:3000,http://localhost:5173
